{
  "name": "taskmaster-ui",
  "version": "1.0.0",
  "description": "Task Master UI - Web interface for task management and CI/CD integration",
  "main": "index.js",
  "workspaces": [
    "packages/backend",
    "packages/frontend"
  ],
  "scripts": {
    "diagram:generate": "./.venv/bin/kube-diagrams -o diagrams/kubernetes-diagram.png packages/backend/kubernetes/deployment.yaml packages/frontend/kubernetes/deployment.yaml",
    "dev": "concurrently \"pnpm run dev:backend\" \"pnpm run dev:frontend\"",
    "dev:watch": "concurrently \"pnpm run dev:backend:watch\" \"pnpm run dev:frontend\"",
    "dev:backend": "pnpm --filter=backend run dev",
    "dev:backend:watch": "pnpm --filter=backend run dev:watch",
    "dev:frontend": "pnpm --filter=frontend run dev",
    "build": "pnpm --filter=backend run build && pnpm --filter=frontend run build",
    "build:backend": "pnpm --filter=backend run build",
    "build:frontend": "pnpm --filter=frontend run build",
    "test": "pnpm --filter=backend run test && pnpm --filter=frontend run test",
    "test:watch": "concurrently \"pnpm run test:backend:watch\" \"pnpm run test:frontend:watch\"",
    "test:backend": "pnpm --filter=backend run test",
    "test:backend:watch": "pnpm --filter=backend run test:watch",
    "test:frontend": "pnpm --filter=frontend run test",
    "test:frontend:watch": "pnpm --filter=frontend run test:watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "lint": "pnpm --filter=backend run lint && pnpm --filter=frontend run lint",
    "lint:fix": "pnpm --filter=backend run lint:fix && pnpm --filter=frontend run lint:fix",
    "lint:backend": "pnpm --filter=backend run lint",
    "lint:frontend": "pnpm --filter=frontend run lint",
    "format": "pnpm --filter=backend run format && pnpm --filter=frontend run format",
    "format:check": "pnpm --filter=backend run format:check && pnpm --filter=frontend run format:check",
    "format:backend": "pnpm --filter=backend run format",
    "format:frontend": "pnpm --filter=frontend run format",
    "clean": "pnpm --filter=backend run clean && pnpm --filter=frontend run clean",
    "start": "pnpm --filter=backend run start",
    "start:backend": "pnpm --filter=backend run start",
    "start:frontend": "pnpm --filter=frontend run start",
    "db:studio": "pnpm --filter=backend run db:studio",
    "db:migrate": "pnpm --filter=backend run db:migrate",
    "db:migrate:deploy": "pnpm --filter=backend run db:migrate:deploy",
    "db:seed": "pnpm --filter=backend run db:seed",
    "db:seed:minimal": "pnpm --filter=backend run db:seed:minimal",
    "db:seed:verbose": "pnpm --filter=backend run db:seed:verbose",
    "db:reset": "pnpm --filter=backend run db:reset",
    "db:reset:quick": "pnpm --filter=backend run db:reset:quick",
    "db:reset:no-seed": "pnpm --filter=backend run db:reset:no-seed",
    "db:reset:force": "pnpm --filter=backend run db:reset:force",
    "db:status": "pnpm --filter=backend run db:status",
    "db:test": "pnpm --filter=backend run db:test",
    "db:verify": "pnpm --filter=backend run db:verify",
    "db:generate": "pnpm --filter=backend run db:generate",
    "db:push": "pnpm --filter=backend run db:push",
    "db:pull": "pnpm --filter=backend run db:pull",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:build": "docker-compose build",
    "docker:dev": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml up",
    "docker:dev:build": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml up --build",
    "docker:watch": "docker-compose watch",
    "docker:logs": "docker-compose logs -f",
    "docker:logs:backend": "docker-compose logs -f backend",
    "docker:logs:frontend": "docker-compose logs -f frontend",
    "docker:logs:storybook": "docker-compose logs -f storybook",
    "docker:clean": "docker-compose down -v --remove-orphans && docker system prune -f",
    "docker:reset": "pnpm run docker:clean && pnpm run docker:build",
    "storybook": "pnpm --filter=frontend run storybook",
    "storybook:build": "pnpm --filter=frontend run build-storybook",
    "tunnel:start": "nohup lt --port 6006 --subdomain taskmaster-storybook > /tmp/storybook-tunnel.log 2>&1 & nohup lt --port 8080 --subdomain taskmaster-frontend > /tmp/frontend-tunnel.log 2>&1 & sleep 5 && echo 'Tunnels started. URLs:' && cat /tmp/storybook-tunnel.log && cat /tmp/frontend-tunnel.log",
    "tunnel:stop": "pkill -f 'lt --port' && echo 'All tunnels stopped'",
    "tunnel:status": "ps aux | grep 'lt --port' | grep -v grep",
    "tunnel:logs": "echo 'Storybook tunnel:' && cat /tmp/storybook-tunnel.log && echo 'Frontend tunnel:' && cat /tmp/frontend-tunnel.log",
    "type-check": "pnpm --filter=backend run type-check && pnpm --filter=frontend run type-check",
    "test:coverage": "pnpm --filter=backend run test:coverage && pnpm --filter=frontend run test:coverage",
    "build:prod": "NODE_ENV=production pnpm run build",
    "validate": "pnpm run type-check && pnpm run lint && pnpm run test",
    "security:audit": "pnpm audit --audit-level moderate",
    "deps:update": "pnpm update --latest --recursive",
    "precommit": "pnpm run type-check && pnpm run lint",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gcheliz/taskmaster-ui.git"
  },
  "keywords": [
    "taskmaster",
    "ui",
    "task-management",
    "ci-cd"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/gcheliz/taskmaster-ui/issues"
  },
  "homepage": "https://github.com/gcheliz/taskmaster-ui#readme",
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^11.1.0",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^9.2.6",
    "@semantic-release/npm": "^11.0.2",
    "@semantic-release/release-notes-generator": "^12.1.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "glob": "^11.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "playwright": "^1.54.1",
    "prettier": "^3.1.1",
    "semantic-release": "^22.0.12"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.25.0"
    }
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1"
  }
}
