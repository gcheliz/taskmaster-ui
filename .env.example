# TaskMaster UI Environment Configuration
# Copy this file to .env and customize for your environment
# WARNING: Never commit real secrets to version control

# Core Service Configuration
PORT=8080
HOST=localhost
LOG_LEVEL=info

# Database Configuration
POSTGRES_USER=taskmaster
POSTGRES_PASSWORD=your_secure_database_password
POSTGRES_DB=taskmaster_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATA_PATH=./database/data
DATABASE_URL="postgresql://taskmaster:your_secure_database_password@localhost:5432/taskmaster_dev?schema=public"

# Security Configuration (REQUIRED - Must be at least 32 characters)
JWT_SECRET=your-jwt-secret-minimum-32-characters-example
ENCRYPTION_KEY=your-encryption-key-minimum-32-characters-example

# Kubernetes Configuration
KUBECONFIG=~/.kube/config
KUBE_ENABLED=true
USE_GKE_GCLOUD_AUTH_PLUGIN=true

# Datadog Integration
DATADOG_API_KEY=your_datadog_api_key_here
DATADOG_APP_KEY=your_datadog_app_key_here
DATADOG_SITE=datadoghq.eu
DATADOG_ENABLED=true

# GitHub Integration
GITHUB_TOKEN=your_github_token_here
GITHUB_OWNER=your_github_organization
GITHUB_ENABLED=true

# Slack Integration
SLACK_BOT_TOKEN=your_slack_bot_token_here
SLACK_USER_TOKEN=your_slack_user_token_here
SLACK_ENABLED=true

# AI Services
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_CLOUD_PROJECT=your_google_cloud_project
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Atlassian Integration
JIRA_BASE_URL=https://your_org.atlassian.net
JIRA_USERNAME=your_username
JIRA_USER_EMAIL=your_email@company.com
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_PROJECT_KEY=your_project_key
JIRA_ENABLED=true
CONFLUENCE_BASE_URL=https://your_org.atlassian.net/wiki
CONFLUENCE_USERNAME=your_email@company.com
CONFLUENCE_API_TOKEN=your_confluence_api_token_here