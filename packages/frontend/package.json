{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:docker": "npx vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 500",
    "lint:strict": "eslint . --config .eslintrc.strict.json",
    "preview": "vite preview",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage --run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "type-check": "tsc --noEmit",
    "type-check:strict": "./scripts/type-check.sh --strict",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "validate": "pnpm run type-check && pnpm run lint && pnpm run format:check",
    "validate:strict": "pnpm run type-check:strict && pnpm run lint:strict && pnpm run format:check"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
