# pnpm configuration for TaskMaster UI

# Use node-linker to create proper symlinks
# node-linker=hoisted

# Configure the store directory
# store-dir=~/.pnpm-store

# Configure auto-install of peers
auto-install-peers=true

# Configure public hoist pattern for better compatibility
# public-hoist-pattern=*eslint*,*prettier*,*typescript*

# Configure registry
registry=https://registry.npmjs.org/

# Configure strict-peer-dependencies
strict-peer-dependencies=false

# Configure optional dependencies
optional-dependencies=true

# Configure node version check
engine-strict=true

# Configure save exact
save-exact=false

# Configure shared workspace lockfile
shared-workspace-lockfile=true

# Configure workspace protocol
prefer-workspace-packages=true