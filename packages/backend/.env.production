# Production Environment Configuration
NODE_ENV=production
PORT=3001

# Database Configuration (REQUIRED)
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"
DATABASE_SSL=true

# SSL Certificate Paths (Required when DATABASE_SSL=true)
SSL_CERT_PATH=/path/to/client-cert.pem
SSL_KEY_PATH=/path/to/client-key.pem
SSL_CA_PATH=/path/to/ca-cert.pem

# Security (REQUIRED - Must be at least 32 characters)
JWT_SECRET=your-production-jwt-secret-minimum-32-characters
ENCRYPTION_KEY=your-production-encryption-key-minimum-32-characters

# Performance
ENABLE_QUERY_ANALYSIS=false
QUERY_TIMEOUT=30000
CONNECTION_POOL_SIZE=20

# Logging
LOG_LEVEL=warn

# External Services (Configure as needed)
GITHUB_TOKEN=your-github-production-token
SLACK_BOT_TOKEN=your-slack-production-bot-token
ANTHROPIC_API_KEY=your-anthropic-production-api-key
REDIS_URL=redis://redis-prod:6379

# Monitoring (Recommended for production)
DATADOG_API_KEY=your-production-datadog-api-key
DATADOG_APP_KEY=your-production-datadog-app-key

# External APIs
EXTERNAL_API_BASE_URL=https://api.taskmaster.com

# Development Settings (Should be false in production)
SEED_DATABASE=false
PRISMA_STUDIO_PORT=5555