{
  "watch": ["src", "prisma/schema.prisma"],
  "ext": "ts,prisma",
  "ignore": ["src/**/*.test.ts", "src/**/*.spec.ts", "node_modules", "dist", "src/generated"],
  "exec": "NODE_PATH=/app/node_modules:/app/packages/backend/node_modules ts-node --transpile-only src/index.ts",
  "env": {
    "NODE_ENV": "development",
    "TS_NODE_PROJECT": "./tsconfig.json",
    "TS_NODE_TRANSPILE_ONLY": "true"
  },
  "delay": 1000,
  "verbose": true,
  "events": {
    "start": "echo '🚀 Starting TaskMaster Backend Server...'",
    "restart": "echo '🔄 Restarting due to file changes...'",
    "crash": "echo '💥 Server crashed! Waiting for changes...'",
    "exit": "echo '✅ Server stopped gracefully'"
  }
}