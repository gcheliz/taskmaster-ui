# Frontend Dockerfile for TaskMaster UI with proper pnpm workspace support
FROM node:20-alpine AS base

# Install pnpm
RUN npm install -g pnpm@9

# Set working directory
WORKDIR /app

# Copy root package files first
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Copy all package.json files to maintain workspace structure
COPY packages/frontend/package.json ./packages/frontend/
COPY packages/backend/package.json ./packages/backend/

# Copy backend prisma directory for postinstall script
COPY packages/backend/prisma ./packages/backend/prisma

# Install all dependencies - pnpm will handle workspace linking
RUN pnpm install --frozen-lockfile

# Copy frontend source code
COPY packages/frontend ./packages/frontend

# Development stage
FROM base AS development
WORKDIR /app

# Expose Vite dev server port
EXPOSE 5173

# Run from workspace root using pnpm filter
CMD ["pnpm", "--filter", "frontend", "dev", "--", "--host", "0.0.0.0"]