{
  "*.{js,jsx,ts,tsx}": [
    "eslint --fix",
    "prettier --write"
  ],
  "*.{json,md,yml,yaml}": [
    "prettier --write"
  ],
  "packages/frontend/**/*.{ts,tsx}": [
    "bash -c 'cd packages/frontend && pnpm exec tsc --noEmit'"
  ],
  "packages/backend/**/*.{ts,tsx}": [
    "bash -c 'cd packages/backend && pnpm exec tsc --noEmit'"
  ]
}