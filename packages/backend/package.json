{
  "name": "backend",
  "version": "1.0.0",
  "description": "Task Master UI Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "pnpm db:generate && nodemon",
    "dev:watch": "concurrently \"pnpm db:watch\" \"nodemon\"",
    "build": "pnpm db:generate && tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:reset": "prisma migrate reset",
    "db:seed": "ts-node prisma/seed.ts",
    "db:seed:minimal": "ts-node prisma/seed.ts --minimal",
    "db:seed:verbose": "ts-node prisma/seed.ts --verbose",
    "db:reset": "ts-node scripts/db-reset.ts reset",
    "db:reset:quick": "prisma migrate reset --force && pnpm db:seed",
    "db:reset:no-seed": "ts-node scripts/db-reset.ts reset --skip-seed",
    "db:reset:force": "ts-node scripts/db-reset.ts reset --force",
    "db:status": "ts-node scripts/db-reset.ts status",
    "db:test": "ts-node scripts/db-reset.ts test",
    "db:verify": "ts-node scripts/db-reset.ts verify",
    "db:watch": "chokidar \"prisma/schema.prisma\" -c \"pnpm db:generate\"",
    "db:push": "prisma db push",
    "db:pull": "prisma db pull",
    "clean": "rimraf dist src/generated",
    "postinstall": "pnpm db:generate"
  },
  "keywords": [
    "taskmaster",
    "backend",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "@types/chokidar": "^1.7.5",
    "@types/uuid": "^10.0.0",
    "chokidar": "^3.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "prisma": "^6.12.0",
    "simple-git": "^3.28.0",
    "uuid": "^11.1.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.5",
    "@types/supertest": "^2.0.16",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "rimraf": "^6.0.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
