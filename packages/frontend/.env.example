# TaskMaster UI Frontend Environment Variables
# Copy this file to .env and configure as needed

# API Configuration
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001

# Performance Monitoring (opt-in - set to 'true' to enable)
VITE_ENABLE_PERFORMANCE_MONITORING=false
VITE_ENABLE_WEB_VITALS=false
VITE_ENABLE_FPS_MONITOR=false
VITE_ENABLE_PROFILER=false

# Feature Flags
VITE_ENABLE_MOCK=false

# Optional - Sentry Error Tracking
# VITE_SENTRY_DSN=your_sentry_dsn_here

# Optional - Google Analytics
# VITE_GA_TRACKING_ID=your_ga_id_here