// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Core Models
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  avatar    String?
  provider  String?  // 'local', 'google', 'github'
  providerId String? // OAuth provider user ID
  password  String?  // For local auth, hashed
  emailVerified Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // User preferences and settings (legacy)
  preferences Json?
  
  // Relations
  projects   UserProject[]
  settings   UserSettings?
  
  // Performance indexes
  @@index([provider, providerId])            // OAuth lookup
  @@index([createdAt])                       // Order by creation date
  @@map("users")
}

model UserSettings {
  id     String @id @default(cuid())
  userId String @unique
  
  // Profile settings
  firstName String?
  lastName  String?
  bio       String?
  jobTitle  String?
  company   String?
  location  String?
  website   String?
  timezone  String? @default("UTC")
  language  String? @default("en")
  
  // Appearance settings
  theme           String?  @default("light") // 'light', 'dark', 'system'
  colorScheme     String?  @default("blue")
  fontSize        String?  @default("md")    // 'sm', 'md', 'lg'
  density         String?  @default("comfortable") // 'compact', 'comfortable', 'spacious'
  animations      Boolean? @default(true)
  glassmorphism   Boolean? @default(true)
  
  // Notification settings
  emailNotifications      Boolean? @default(true)
  pushNotifications       Boolean? @default(true)
  slackNotifications      Boolean? @default(false)
  desktopNotifications    Boolean? @default(true)
  notificationSettings    Json?    // Detailed notification preferences
  
  // Integration settings
  integrationSettings Json? // OAuth connections, webhooks, etc.
  
  // Security settings
  twoFactorEnabled    Boolean? @default(false)
  loginNotifications  Boolean? @default(true)
  securitySettings    Json?    // Detailed security preferences
  
  // Dashboard preferences
  dashboardLayout     String?  @default("grid") // 'grid', 'list'
  cardsPerRow         Int?     @default(3)
  showQuickActions    Boolean? @default(true)
  
  // Accessibility
  highContrast        Boolean? @default(false)
  reducedMotion       Boolean? @default(false)
  focusIndicators     Boolean? @default(true)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@map("user_settings")
}

model UserProject {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  role      String   @default("member") // 'owner', 'admin', 'member', 'viewer'
  createdAt DateTime @default(now())
  
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
  @@map("user_projects")
}

model Project {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  path        String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  repositories Repository[]
  tasks        Task[]
  users        UserProject[]
  
  // Performance indexes
  @@index([createdAt])                       // Order by creation date
  @@index([updatedAt])                       // Order by last updated
  @@map("projects")
}

model Repository {
  id        String   @id @default(cuid())
  name      String
  url       String?
  path      String   @unique
  branch    String   @default("main")
  projectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  commits Commit[]
  
  // Performance indexes
  @@index([projectId])                       // Query repositories by project
  @@index([createdAt])                       // Order by creation date
  @@index([projectId, createdAt])            // Recent repositories per project
  @@unique([projectId, name])
  @@map("repositories")
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(PENDING)
  priority    Priority   @default(MEDIUM)
  projectId   String
  parentId    String?
  order       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  dueDate     DateTime?
  
  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent   Task?   @relation("TaskHierarchy", fields: [parentId], references: [id])
  children Task[]  @relation("TaskHierarchy")
  
  // Performance indexes
  @@index([status])                          // Query tasks by status
  @@index([priority])                        // Query tasks by priority  
  @@index([projectId])                       // Already exists via FK, but explicit for clarity
  @@index([parentId])                        // Query child tasks
  @@index([createdAt])                       // Order by creation date
  @@index([status, priority])                // Combined queries (status + priority)
  @@index([projectId, status])               // Project-specific status queries
  @@index([projectId, createdAt])            // Recent tasks per project
  @@index([dueDate])                         // Query tasks by due date
  @@index([status, dueDate])                 // Overdue task queries
  @@map("tasks")
}

model Commit {
  id           String   @id @default(cuid())
  hash         String   @unique
  message      String
  author       String
  timestamp    DateTime
  repositoryId String
  createdAt    DateTime @default(now())
  
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  
  // Performance indexes
  @@index([repositoryId])                    // Query commits by repository
  @@index([timestamp])                       // Order by commit timestamp
  @@index([author])                          // Query commits by author
  @@index([repositoryId, timestamp])         // Recent commits per repository
  @@index([author, timestamp])               // Recent commits by author
  @@map("commits")
}

// Enums
enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  BLOCKED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}