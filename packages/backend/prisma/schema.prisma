// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Core Models
model Project {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  path        String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  repositories Repository[]
  tasks        Task[]
  
  // Performance indexes
  @@index([createdAt])                       // Order by creation date
  @@index([updatedAt])                       // Order by last updated
  @@map("projects")
}

model Repository {
  id        String   @id @default(cuid())
  name      String
  url       String?
  path      String   @unique
  branch    String   @default("main")
  projectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  commits Commit[]
  
  // Performance indexes
  @@index([projectId])                       // Query repositories by project
  @@index([createdAt])                       // Order by creation date
  @@index([projectId, createdAt])            // Recent repositories per project
  @@unique([projectId, name])
  @@map("repositories")
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(PENDING)
  priority    Priority   @default(MEDIUM)
  projectId   String
  parentId    String?
  order       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  dueDate     DateTime?
  
  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent   Task?   @relation("TaskHierarchy", fields: [parentId], references: [id])
  children Task[]  @relation("TaskHierarchy")
  
  // Performance indexes
  @@index([status])                          // Query tasks by status
  @@index([priority])                        // Query tasks by priority  
  @@index([projectId])                       // Already exists via FK, but explicit for clarity
  @@index([parentId])                        // Query child tasks
  @@index([createdAt])                       // Order by creation date
  @@index([status, priority])                // Combined queries (status + priority)
  @@index([projectId, status])               // Project-specific status queries
  @@index([projectId, createdAt])            // Recent tasks per project
  @@index([dueDate])                         // Query tasks by due date
  @@index([status, dueDate])                 // Overdue task queries
  @@map("tasks")
}

model Commit {
  id           String   @id @default(cuid())
  hash         String   @unique
  message      String
  author       String
  timestamp    DateTime
  repositoryId String
  createdAt    DateTime @default(now())
  
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  
  // Performance indexes
  @@index([repositoryId])                    // Query commits by repository
  @@index([timestamp])                       // Order by commit timestamp
  @@index([author])                          // Query commits by author
  @@index([repositoryId, timestamp])         // Recent commits per repository
  @@index([author, timestamp])               // Recent commits by author
  @@map("commits")
}

// Enums
enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  BLOCKED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}