{
  "name": "backend",
  "version": "1.0.0",
  "description": "Task Master UI Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "pnpm db:generate && nodemon",
    "dev:watch": "concurrently \"pnpm db:watch\" \"nodemon\"",
    "build": "pnpm db:generate && tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:reset": "prisma migrate reset",
    "db:seed": "ts-node prisma/seed.ts",
    "db:seed:minimal": "ts-node prisma/seed.ts --minimal",
    "db:seed:verbose": "ts-node prisma/seed.ts --verbose",
    "db:reset": "ts-node scripts/db-reset.ts reset",
    "db:reset:quick": "prisma migrate reset --force && pnpm db:seed",
    "db:reset:no-seed": "ts-node scripts/db-reset.ts reset --skip-seed",
    "db:reset:force": "ts-node scripts/db-reset.ts reset --force",
    "db:status": "ts-node scripts/db-reset.ts status",
    "db:test": "ts-node scripts/db-reset.ts test",
    "db:verify": "ts-node scripts/db-reset.ts verify",
    "db:watch": "chokidar \"prisma/schema.prisma\" -c \"pnpm db:generate\"",
    "db:push": "prisma db push",
    "db:pull": "prisma db pull",
    "performance:test": "ts-node scripts/performance-test.ts",
    "performance:test:verbose": "ts-node scripts/performance-test.ts --verbose",
    "env:validate": "node scripts/validate-environment.js",
    "env:check": "node scripts/validate-environment.js",
    "secrets:test": "ts-node scripts/test-secrets-manager.ts",
    "ssl:test": "ts-node scripts/test-ssl-connection.ts",
    "clean": "rimraf dist src/generated",
    "postinstall": "pnpm db:generate"
  },
  "keywords": [
    "taskmaster",
    "backend",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "@sentry/node": "^9.42.0",
    "@types/chokidar": "^1.7.5",
    "@types/lodash": "^4.17.20",
    "@types/uuid": "^10.0.0",
    "bcryptjs": "^3.0.2",
    "bull": "^4.16.5",
    "chokidar": "^4.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "json2csv": "6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "prisma": "^6.12.0",
    "simple-git": "^3.28.0",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "ws": "^8.14.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.2",
    "@types/jest": "^29.5.8",
    "@types/json2csv": "^5.0.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.5",
    "@types/passport": "^1.0.17",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/supertest": "^2.0.16",
    "@types/ws": "^8.5.10",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^8.2.2",
    "eslint": "^9.31.0",
    "globals": "^16.3.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "rimraf": "^6.0.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.37.0"
  }
}
