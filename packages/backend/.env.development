# Development Environment Configuration
NODE_ENV=development
PORT=3001

# Database Configuration
DATABASE_URL="postgresql://taskmaster:your_secure_database_password@localhost:5432/taskmaster_dev?schema=public"
DATABASE_SSL=false

# Security (Development - Auto-generated if not set)
# JWT_SECRET=your-jwt-secret-here-minimum-32-characters
# ENCRYPTION_KEY=your-encryption-key-here-minimum-32-characters

# Performance
ENABLE_QUERY_ANALYSIS=true
QUERY_TIMEOUT=30000
CONNECTION_POOL_SIZE=5

# Development Tools
SEED_DATABASE=false
PRISMA_STUDIO_PORT=5555

# Logging
LOG_LEVEL=debug

# External Services (Optional for development)
# GITHUB_TOKEN=your-github-token-here
# SLACK_BOT_TOKEN=your-slack-bot-token-here
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# REDIS_URL=redis://localhost:6379

# Monitoring (Optional for development)
# DATADOG_API_KEY=your-datadog-api-key-here
# DATADOG_APP_KEY=your-datadog-app-key-here